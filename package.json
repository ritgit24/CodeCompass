{
  "name": "codecompass",
  "version": "0.1.0",
  "private": true,
  "description": "Turn any GitHub repo into an interactive onboarding guide and a guided first PR.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @codecompass/api",
    "dev:web": "npm run dev -w @codecompass/web",
    "build": "npm run build -w @codecompass/api && npm run build -w @codecompass/web",
    "typecheck": "npm run typecheck -w @codecompass/api && npm run typecheck -w @codecompass/web",
    "test": "npm run test -w @codecompass/api",
    "test:e2e": "npm run test:e2e -w @codecompass/web",
    "lint": "eslint .",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "node": ">=22"
  }
}
