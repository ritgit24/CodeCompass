# ---------------------------------------------------------------------------
# CodeCompass environment
# Copy to `.env` and fill in what you need. Everything below works with the
# defaults using AGENT_PROVIDER=mock (no keys required for a full demo).
# ---------------------------------------------------------------------------

# --- GitHub (optional) ------------------------------------------------------
# Raises the API rate limit for issue/user metadata lookups. Cloning public
# repos works without it.
GITHUB_TOKEN=

# --- Agent provider ---------------------------------------------------------
# mock   -> canned, deterministic output. No keys. Great for demos/tests.
# cline  -> real Cline SDK agent (@cline/sdk). Needs provider + key below.
# direct -> plain OpenAI-compatible chat completions call.
AGENT_PROVIDER=mock

# --- Cline SDK provider (used when AGENT_PROVIDER=cline) ---------------------
CLINE_PROVIDER_ID=anthropic
CLINE_MODEL_ID=claude-sonnet-4-6

# --- LLM credentials --------------------------------------------------------
# For AGENT_PROVIDER=cline: the API key for CLINE_PROVIDER_ID above.
# For AGENT_PROVIDER=direct: the key for LLM_BASE_URL.
LLM_API_KEY=

# --- Direct provider (used when AGENT_PROVIDER=direct) ----------------------
# Any OpenAI-compatible base URL. The model must be enabled for your key and
# actually serving requests (a wrong/disabled id shows up as "fetch failed").
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Give up on a provider request after this long (ms). Sandboxed agent edits use
# a longer timeout of their own.
LLM_TIMEOUT_MS=60000

# --- Server -----------------------------------------------------------------
PORT=4000
# Base URL the frontend uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Where shallow clones and fix-session copies are stored.
WORKSPACE_DIR=./workspace
# Where the SQLite database lives (defaults to ./data).
DATA_DIR=./data

# --- Analysis limits --------------------------------------------------------
MAX_REPO_MB=100
MAX_FILES=4000
TEST_TIMEOUT_MS=120000
